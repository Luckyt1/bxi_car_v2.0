# Install as /etc/bxi/control_backend.env, outside the gateway OTA package.
# Preserve existing ROS_DOMAIN_ID / RMW_IMPLEMENTATION / DDS configuration.
BXI_CONTROL_BACKEND=car2
BXI_CAR2_ROOT=/opt/bxi/car2
BXI_CAR2_ENABLE_ARM=1
BXI_CAR2_CONFIG_DIR=/var/lib/bxi/car2/config
BXI_CAR2_STATE_DIR=/var/lib/bxi/car2/state
BXI_CAR2_LOG_DIR=/var/log/bxi/car2
BXI_CAR2_LOCK_FILE=/var/lib/bxi/car2/control.lock

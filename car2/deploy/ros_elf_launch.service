# Deployment example. Adjust /opt/bxi_car/car2, NIC and joystick for this machine.
[Unit]
Description=Chassis and EtherCAT arm joystick control (wait for start button)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bxi_car/car2
Environment=JOYSTICK_DEVICE=/dev/input/js0
Environment=CHASSIS_CONFIG=/opt/bxi_car/car2/src/config/steering.yaml
Environment=YIYOU_CONFIG=/opt/bxi_car/car2/src/config/yiyou_ethercat.yaml
ExecStartPre=/usr/bin/test -x /opt/bxi_car/car2/build/chassis/robot_control
ExecStartPre=/usr/sbin/ip link set dev enp86s0 up
ExecStart=/bin/bash /opt/bxi_car/car2/start_chassis_arm.sh
Restart=always
RestartSec=3
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=15s
SendSIGKILL=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
